{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "cSpell.enabled": true,
  "cSpell.words": [],
  "remote.autoForwardPorts": true,
  "remote.localPortHost": "allInterfaces",
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "MARK",
    "FIX",
    "TODO",
    "[ ]",
    "[x]"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "examples": true,
    "node_modules": true
  },
  "explorerExclude.backup": {},
}
